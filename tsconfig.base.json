{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "esnext",
    "lib": ["ES2022", "dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@analytics-admin/api-client": ["./libs/api-client/src/index.ts"],
      "@analytics-admin/contracts": ["./libs/contracts/src/index.ts"],
      "@analytics-admin/config": ["./libs/config/src/index.ts"],
      "@analytics-admin/data-core": ["./libs/data-core/src/index.ts"],
      "@analytics-admin/governance": ["./libs/governance/src/index.ts"],
      "@analytics-admin/operations": ["./libs/operations/src/index.ts"],
      "@analytics-admin/resilience": ["./libs/resilience/src/index.ts"],
      "@analytics-admin/sales": ["./libs/sales/src/index.ts"],
      "@analytics-admin/testing": ["./libs/testing/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
