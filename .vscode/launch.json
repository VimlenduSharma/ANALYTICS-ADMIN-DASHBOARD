{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dashboard: browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/apps/web"
    },
    {
      "name": "Dashboard: API",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:api",
      "cwd": "${workspaceFolder}"
    }
  ]
}
